<Application x:Class="AdvCamera.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/PresentationFramework.Fluent;component/Themes/Fluent.Dark.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
            <SolidColorBrush x:Key="SubtleBorder" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="PanelBackground" Color="#FF262626" />

            <Style x:Key="Icon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SymbolIcon" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="Segoe UI Symbol" />
                <Setter Property="FontSize" Value="17" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="0,-3,0,0" />
            </Style>

            <Style x:Key="ToolLabel" TargetType="TextBlock">
                <Setter Property="Margin" Value="6,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <Style x:Key="ToolToggle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Setter Property="Padding" Value="10,5" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <Style x:Key="ToolSeparator" TargetType="Rectangle">
                <Setter Property="Width" Value="1" />
                <Setter Property="Margin" Value="6,4" />
                <Setter Property="Fill" Value="{StaticResource SubtleBorder}" />
            </Style>

            <!-- Small borderless button (used for "reset" icons next to sliders) -->
            <Style x:Key="FlatIconButton" TargetType="Button">
                <Setter Property="Foreground" Value="#FFE8E8E8" />
                <Setter Property="Padding" Value="5,3" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Focusable" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="Transparent" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#26FFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#40FFFFFF" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHint" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Opacity" Value="0.7" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="PanelExpander" TargetType="Expander" BasedOn="{StaticResource {x:Type Expander}}">
                <Setter Property="Margin" Value="0,4" />
                <Setter Property="IsExpanded" Value="True" />
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
