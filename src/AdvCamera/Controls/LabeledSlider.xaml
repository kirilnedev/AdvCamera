<UserControl x:Class="AdvCamera.Controls.LabeledSlider"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <StackPanel Margin="0,2,0,4">
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource FlatIconButton}" Click="Reset_Click"
                    ToolTip="Reset to default (or double-click the slider)">
                <TextBlock Style="{StaticResource Icon}" FontSize="12" Text="&#xE7A7;" />
            </Button>
            <TextBlock x:Name="ValueText" DockPanel.Dock="Right" Margin="0,0,4,0" VerticalAlignment="Center"
                       Opacity="0.75" Typography.NumeralAlignment="Tabular" />
            <TextBlock Text="{Binding Title, ElementName=Root}" VerticalAlignment="Center" />
        </DockPanel>
        <Slider Minimum="{Binding Minimum, ElementName=Root}"
                Maximum="{Binding Maximum, ElementName=Root}"
                Value="{Binding Value, ElementName=Root}"
                SmallChange="{Binding Step, ElementName=Root}"
                LargeChange="{Binding LargeStep, ElementName=Root}"
                TickFrequency="{Binding Step, ElementName=Root}"
                IsSnapToTickEnabled="True"
                IsMoveToPointEnabled="True"
                Focusable="False"
                MouseDoubleClick="Slider_MouseDoubleClick" />
    </StackPanel>
</UserControl>
